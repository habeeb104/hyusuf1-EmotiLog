<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="How are you feeling?"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"
        android:textColor="#333333" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="3"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="false"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/btn_happy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="Happy"
            android:drawableTop="@drawable/ic_happy"
            android:backgroundTint="#FFEB3B"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btn_sad"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="Sad"
            android:drawableTop="@drawable/ic_sad"
            android:backgroundTint="#2196F3" />

        <Button
            android:id="@+id/btn_angry"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="Angry"
            android:drawableTop="@drawable/ic_angry"
            android:backgroundTint="#F44336" />

        <Button
            android:id="@+id/btn_scared"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="Scared"
            android:drawableTop="@drawable/ic_scared"
            android:backgroundTint="#4CAF50" />

        <Button
            android:id="@+id/btn_excited"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="Excited"
            android:drawableTop="@drawable/ic_excited"
            android:backgroundTint="#FF9800" />

        <Button
            android:id="@+id/btn_surprised"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="Surprised"
            android:drawableTop="@drawable/ic_surprised"
            android:backgroundTint="#9C27B0" />
    </GridLayout>

    <Button
        android:id="@+id/btn_view_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Daily Summary"
        android:onClick="onViewSummaryClicked"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_view_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Log History"
        android:layout_marginTop="16dp" />


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/white"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_summary_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Press a button to start logging!"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp" />
    </ScrollView>

</LinearLayout>